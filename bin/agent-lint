#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * agent-lint — vypíše, čo by previerka balíka odmietla na deklarácii nástrojov, bez
 * spustenia platformy.
 *
 * Použitie:  vendor/bin/agent-lint "Leoness\\Agent\\X\\Tool\\MojNastrojTool" [...]
 *
 * Pravidlá sú tie isté ako v {@see Leoness\AgentTestkit\ToolDeclarationCase}: #[AsTool]
 * s názvom v snake_case a popisom, a #[IsGrantedTool('TOOL_<NÁZOV>')].
 */

use Leoness\AgentTestkit\ToolDeclarationLint;

// Composer's bin proxy announces the project autoloader; the fallbacks cover being run
// straight from a checkout of this repository.
foreach ([$GLOBALS['_composer_autoload_path'] ?? null, __DIR__.'/../../../autoload.php', __DIR__.'/../vendor/autoload.php'] as $autoload) {
    if (null !== $autoload && is_file($autoload)) {
        require $autoload;
        break;
    }
}

$classes = array_slice($_SERVER['argv'], 1);

if ([] === $classes) {
    fwrite(STDERR, "Použitie: agent-lint <TriedaNástroja> [...]\n");
    exit(2);
}

$lint = new ToolDeclarationLint();
$failed = false;

foreach ($classes as $class) {
    if (!class_exists($class)) {
        fwrite(STDERR, sprintf("[CHYBA] Trieda %s neexistuje.\n", $class));
        $failed = true;
        continue;
    }

    $problems = $lint->problemsOf($class);

    foreach ($problems as $problem) {
        fwrite(STDERR, sprintf("[CHYBA] %s\n", $problem));
    }

    if ([] === $problems) {
        fwrite(STDOUT, sprintf("[OK] %s: %s\n", $class, implode(', ', $lint->toolNames($class))));
    }

    $failed = $failed || [] !== $problems;
}

exit($failed ? 1 : 0);
