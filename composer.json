{
    "name": "leoness/agent-testkit",
    "description": "Test schopnosti nasadenia pre agentové balíky Leoness AI — bez DB, bez core, bez siete.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "leoness/agent-sdk": "^2.0",
        "opis/json-schema": "^2.6",
        "php": ">=8.4",
        "phpunit/phpunit": "^13.0",
        "psr/log": "^3.0",
        "symfony/notifier": "^7.2|^8.0",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Leoness\\AgentTestkit\\": "src/"
        }
    },
    "bin": [
        "bin/agent-lint"
    ],
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/tito10047/agent-sdk"
        }
    ]
}
