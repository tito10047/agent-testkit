{
    "name": "leoness/agent-testkit",
    "description": "Pomôcky na testovanie balíkov MCP nástrojov Leoness AI — stuby portov SDK a kontrola deklarácie nástrojov, bez DB, bez core, bez siete.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "leoness/agent-sdk": "^4.0",
        "php": ">=8.4",
        "phpunit/phpunit": "^13.0",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Leoness\\AgentTestkit\\": "src/"
        }
    },
    "bin": [
        "bin/agent-lint"
    ],
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/tito10047/agent-sdk",
            "no-api": true
        }
    ]
}
